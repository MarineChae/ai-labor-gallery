# GitHub Actions에서는 Repository secrets에 등록하세요. 이 파일을 .env로 복사할 필요는 없습니다.
# 로컬 실행: node --env-file=.env scripts/generate.mjs
OPENAI_API_KEY=
# 키를 등록하는 것만으로 유료 생성을 켜지 않습니다. 둘 다 설정해야 합니다.
GALLERY_GENERATION_MODE=template
OPENAI_MODEL=gpt-4.1-mini
# 선택 사항. 공개를 승인한 요약만 허용. 원문/이메일/실명/업무 기밀은 금지.
# GALLERY_CONTEXT_JSON={"approvedForPublication":true,"expiresAt":"2026-11-19T00:00:00Z","summary":"작은 수정에서 시작해 UI를 세 번 고친 이야기"}
